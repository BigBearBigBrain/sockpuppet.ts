{
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-write --unstable --watch ./main.ts"
  },
  "imports": {
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@^0.11.0",
    "@std/assert": "jsr:@std/assert@^1.0.6",
    "@std/http": "jsr:@std/http@^1.0.8",
    "@std/testing": "jsr:@std/testing@^1.0.3",
    "esbuild": "npm:esbuild@^0.24.0",
    "@cgg/sockpuppet": "./server/mod.ts",
    "@cgg/sockpuppet/client": "./client/mod.ts"
  },
  "name": "@bearmetal/sockpuppet",
  "version": "1.0.0",
  "description": "A lightweight, event driven, and easy to use WebSocket library for Deno.",
  "exports": {
    ".": "./server/mod.ts",
    "./client": "./client/mod.ts"
  },
  "exclude": [
    "./dash/"
  ],
  "license": "GPLv3",
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable"
    ]
  }
}
